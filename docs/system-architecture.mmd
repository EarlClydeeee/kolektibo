  %% ═══════════════════════════════════════════════════════════════════
  classDef future fill:#1e293b,stroke:#facc15,stroke-width:2px,color:#facc15,stroke-dasharray: 5 5
  classDef current fill:#0f172a,stroke:#22c55e,stroke-width:2px,color:#e2e8f0

  style USERS fill:#312e81,stroke:#818cf8,color:#e0e7ff
  style FRONTEND fill:#1e1b4b,stroke:#6366f1,color:#c7d2fe
  style AUTH fill:#1c1917,stroke:#f97316,color:#fed7aa
  style BACKEND fill:#022c22,stroke:#10b981,color:#a7f3d0
  style INDEXER fill:#172554,stroke:#3b82f6,color:#bfdbfe
  style NOTIFY fill:#4c1d95,stroke:#a78bfa,color:#ede9fe
  style DATABASE fill:#1f2937,stroke:#9ca3af,color:#e5e7eb
  style BLOCKCHAIN fill:#7c2d12,stroke:#f59e0b,color:#fef3c7
  style EXTERNAL fill:#0c4a6e,stroke:#38bdf8,color:#e0f2fe
